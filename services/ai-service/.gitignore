# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Data directories (user uploads and generated content)
data/
config/vector_db/
config/frameworks/*

# The NDI catalog is reference data, not generated user content: without it
# every domain resolves to no controls and evaluations come back empty. It is
# ~250KB of public NDMO standards, so it ships with the repo and a deploy needs
# no extra copy step.
!config/frameworks/NDI/

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Model cache (if downloading models)
.cache/

